# ---------------------------------------------------------------------------
# Kavach environment variables. Copy to .env.local for `next dev`.
# NEXT_PUBLIC_* values are inlined into the browser bundle AT BUILD TIME: they
# must be set when you run `pnpm build` / `pnpm cf:build` (put production
# values in .env.production, which is git-ignored).
# Everything else is a server-only secret: in production set it with
#   pnpm wrangler secret put NAME
# and for `wrangler dev` previews put it in .dev.vars.
# NEVER prefix a secret with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 1) -----------------------------------------------------
# Local: printed by `pnpm supabase start` (API_URL / PUBLISHABLE_KEY / SECRET_KEY).
# Hosted: Project Settings -> API Keys (use the new sb_publishable_/sb_secret_ keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Cron (Phase 1) ---------------------------------------------------------
# Random 32+ char string. Generate: openssl rand -hex 32
CRON_SECRET=

# --- Cloudflare R2 evidence storage (Phase 3) -------------------------------
# R2 -> Manage API tokens -> Create Account API token, permission
# "Object Read & Write", applied to the kavach-evidence bucket only.
# Check the setup with: pnpm storage:check
# Without these, the app still works; evidence uploads show "not available".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kavach-evidence
# Only for a local S3-compatible emulator; leave empty for real R2.
R2_ENDPOINT=
R2_REGION=

# --- Google Gemini (Phase 4) ------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to "gemini-flash-latest" (Google's alias for the newest
# Flash model). Pin a specific id here if you prefer. Check with: pnpm ai:check
GEMINI_MODEL=

# --- Abuse protection (Phase 5) ---------------------------------------------
# Cloudflare dashboard -> Turnstile -> Add widget (Managed). Leave empty in
# local dev to switch bot checks off. Cloudflare test keys that always pass:
# site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash console -> Redis -> REST API. Empty = no rate limits (local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random 16+ chars; IPs are HMAC'd with this before being used as rate-limit keys.
RATE_LIMIT_SALT=

# --- Email (Phase 5) --------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Kavach <noreply@your-domain.in>"

# --- Monitoring & analytics (Phase 5) ---------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- TEST-ONLY overrides (never set in production) --------------------------
# Point third-party services at local fakes when testing without network access.
# GEMINI_API_BASE=
# TURNSTILE_VERIFY_URL=
# NEXT_PUBLIC_TURNSTILE_SCRIPT_URL=

# --- Local Google sign-in for `supabase start` (optional) -------------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
