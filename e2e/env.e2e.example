# Append these to BOTH .env.local and .dev.vars to run the end-to-end suites.
# They point every external service at a local stand-in. Never use in production.
CRON_SECRET=local-dev-cron-secret-0123456789abcdef
# R2 -> moto S3 emulator (:9100)
R2_ENDPOINT=http://127.0.0.1:9100
R2_REGION=us-east-1
R2_ACCESS_KEY_ID=test
R2_SECRET_ACCESS_KEY=test
R2_BUCKET=kavach-evidence
# Gemini -> e2e/fakes/fake-gemini.cjs (:9200)
GEMINI_API_KEY=fake-test-key
GEMINI_API_BASE=http://127.0.0.1:9200
# Turnstile, Sentry, PostHog -> e2e/fakes/fake-services.cjs (:9300)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SCRIPT_URL=http://127.0.0.1:9300/turnstile/api.js
TURNSTILE_SECRET_KEY=test-secret
TURNSTILE_VERIFY_URL=http://127.0.0.1:9300/turnstile/siteverify
NEXT_PUBLIC_SENTRY_DSN=http://publickey@127.0.0.1:9300/1
SENTRY_DSN=http://serverkey@127.0.0.1:9300/2
NEXT_PUBLIC_POSTHOG_KEY=phc_test
NEXT_PUBLIC_POSTHOG_HOST=http://127.0.0.1:9300/posthog
# Upstash -> real Redis via serverless-redis-http + scripts/dev/upstash-shim.mjs (:8078)
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8078
UPSTASH_REDIS_REST_TOKEN=local-upstash-token
RATE_LIMIT_SALT=local-test-salt-0123456789
